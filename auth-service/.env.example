# JWT Token Configuration
JWT_ACCESS_TOKEN_EXPIRES_IN=15
JWT_REFRESH_TOKEN_EXPIRES_IN=7
JWT_ISSUER=vestra-auth-service
JWT_KEY_ID=auth-key-1

# RSA Key Configuration (Geliştirme/test ortamında opsiyoneldir; boş bırakılırsa ephemeral key üretilir)
# Production ortamında MUTLAKA tanımlanmalıdır:
# Seçenek 1: Doğrudan PEM string veya Base64 formatı
# RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# RSA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Seçenek 2: Dosya konumu
# RSA_PRIVATE_KEY_LOCATION=file:/path/to/private_key.pem
# RSA_PUBLIC_KEY_LOCATION=file:/path/to/public_key.pem

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_this_redis_password

# Database
DATASOURCE_URL=jdbc:postgresql://postgres:5432/auth_db
DB_USER=auth_user
DB_PASSWORD=auth_password
DB_NAME=auth_db

# Security & Cookies
COOKIE_SECURE=true
SAME_SITE=Lax
SECURITY_LOGIN_MAX_ATTEMPTS=8
SECURITY_LOCKOUT_MINUTES=5

# Google OAuth2
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_SECRET=your-google-client-secret

CLIENT_URL=http://localhost:3000
SERVER_PORT=8081
